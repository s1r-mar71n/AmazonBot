[Unit]
Description=Amazon price watcher (ntfy alerts)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amazonwatch
Group=amazonwatch
WorkingDirectory=/opt/amazon-watch
ExecStart=/opt/amazon-watch/.venv/bin/python /opt/amazon-watch/amazon_watch.py --config /opt/amazon-watch/config.toml
Restart=on-failure
RestartSec=120

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/amazon-watch
MemoryMax=200M

[Install]
WantedBy=multi-user.target
